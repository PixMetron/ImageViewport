<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<AssemblyName>PixMetron.Controls.ImageViewport.Facade</AssemblyName>
	<RootNamespace>PixMetron.Controls.ImageViewport.Facade</RootNamespace>

	  <!-- NuGet 基本信息 -->
	  <PackageId>PixMetron.Controls.ImageViewport.Facade</PackageId>
	  <!-- 用 SemVer，预发布如 1.1.0-beta.1 -->
	  <Version>0.1.0-beta.0</Version>
	  <Authors>PixMetron</Authors>
	  <Description>Extensible facade for ImageViewport with programmatic API for dynamic surface management, Z-index ordering, group operations, composable input routing, and batch updates.</Description>
	  <PackageTags>WPF;Viewport;Imaging</PackageTags>

	  <!-- 可见性与合规 -->
	  <PackageProjectUrl>https://github.com/PixMetron</PackageProjectUrl>
	  <RepositoryUrl>https://github.com/PixMetron/ImageViewport</RepositoryUrl>
	  <RepositoryType>git</RepositoryType>
	  <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>

	  <!-- README / 图标（会显示在 nuget.org 包页） -->
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <!--<PackageIcon>docs\icon.png</PackageIcon>-->

	  <!-- 文档与 SourceLink（推荐） -->
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
	  <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="docs\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PixMetron.Controls.ImageViewport.Handlers\PixMetron.Controls.ImageViewport.Handlers.csproj" />
    <ProjectReference Include="..\PixMetron.Controls.ImageViewport.Surfaces\PixMetron.Controls.ImageViewport.Surfaces.csproj" />
    <ProjectReference Include="..\PixMetron.Controls.ImageViewport\PixMetron.Controls.ImageViewport.csproj" />
  </ItemGroup>
</Project>
